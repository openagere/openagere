{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ProviderUsageDailyBucket": {
      "description": "A single day's token usage for a provider.",
      "properties": {
        "cachedInputTokens": {
          "description": "Cached input tokens used on this date.",
          "format": "int64",
          "type": "integer"
        },
        "date": {
          "description": "ISO-8601 date string (YYYY-MM-DD).",
          "type": "string"
        },
        "inputTokens": {
          "description": "Input tokens used on this date.",
          "format": "int64",
          "type": "integer"
        },
        "outputTokens": {
          "description": "Output tokens used on this date.",
          "format": "int64",
          "type": "integer"
        },
        "reasoningOutputTokens": {
          "description": "Reasoning output tokens used on this date.",
          "format": "int64",
          "type": "integer"
        },
        "totalTokens": {
          "description": "Total tokens used on this date.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "date",
        "inputTokens",
        "outputTokens",
        "reasoningOutputTokens",
        "totalTokens"
      ],
      "type": "object"
    },
    "ProviderUsageSummary": {
      "description": "Per-provider token usage summary with daily breakdown.",
      "properties": {
        "cachedInputTokens": {
          "description": "Total cached input tokens.",
          "format": "int64",
          "type": "integer"
        },
        "dailyBuckets": {
          "description": "Daily usage buckets sorted by date ascending.",
          "items": {
            "$ref": "#/definitions/ProviderUsageDailyBucket"
          },
          "type": "array"
        },
        "inputTokens": {
          "description": "Total input tokens.",
          "format": "int64",
          "type": "integer"
        },
        "outputTokens": {
          "description": "Total output tokens.",
          "format": "int64",
          "type": "integer"
        },
        "peakDailyTokens": {
          "description": "Highest single-day total across all dates.",
          "format": "int64",
          "type": "integer"
        },
        "providerId": {
          "description": "Provider identifier (e.g. \"openai\", \"anthropic\").",
          "type": "string"
        },
        "reasoningOutputTokens": {
          "description": "Total reasoning output tokens.",
          "format": "int64",
          "type": "integer"
        },
        "totalTokens": {
          "description": "Total tokens consumed across all recorded days.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "dailyBuckets",
        "inputTokens",
        "outputTokens",
        "peakDailyTokens",
        "providerId",
        "reasoningOutputTokens",
        "totalTokens"
      ],
      "type": "object"
    },
    "ProviderUsageTotal": {
      "description": "Aggregate totals across all providers.",
      "properties": {
        "cachedInputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "dailyBuckets": {
          "description": "Daily totals across all providers, sorted by date ascending.",
          "items": {
            "$ref": "#/definitions/ProviderUsageDailyBucket"
          },
          "type": "array"
        },
        "inputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "longestRunningTurnSec": {
          "description": "Wall-clock seconds of the longest single turn recorded, or `None` if no turns exist.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "outputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "peakDailyTokens": {
          "format": "int64",
          "type": "integer"
        },
        "reasoningOutputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "totalTokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "dailyBuckets",
        "inputTokens",
        "outputTokens",
        "peakDailyTokens",
        "reasoningOutputTokens",
        "totalTokens"
      ],
      "type": "object"
    }
  },
  "description": "Response for `usage/read` — aggregated token usage broken down by provider.",
  "properties": {
    "providers": {
      "description": "Per-provider summaries.",
      "items": {
        "$ref": "#/definitions/ProviderUsageSummary"
      },
      "type": "array"
    },
    "total": {
      "allOf": [
        {
          "$ref": "#/definitions/ProviderUsageTotal"
        }
      ],
      "description": "Aggregate across all providers."
    }
  },
  "required": [
    "providers",
    "total"
  ],
  "title": "GetProviderUsageResponse",
  "type": "object"
}